# ─────────────────────────────────────────────────────────────────────────────
#  .env.example  —  copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you: it asks which
#  integrations you want, collects each key, and writes .env.local.
#
#  Every key here is OPTIONAL. With none set, Vox runs in DEMO MODE with
#  realistic call logs, transcripts and voice agents so you can see it instantly.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The business's own line, shown in the cockpit top bar. Leave empty and the
# pill is hidden — better than showing a placeholder number to a customer.
NEXT_PUBLIC_BUSINESS_PHONE=

# ── Vapi (telephony + realtime voice) ────────────────────────────────────────
# Answers inbound calls, streams audio and drives the agent.
# https://docs.vapi.ai/api-reference
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=

# ── Twilio (phone numbers, SMS, transfer) ────────────────────────────────────
# Provision numbers and warm-transfer/route calls.
# https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── LLM brain (OpenAI or Anthropic) ──────────────────────────────────────────
# Understands the caller, follows the agent prompt and decides actions.
# https://platform.openai.com/api-keys  ·  https://console.anthropic.com/
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Calendar (Cal.com or Google Calendar) ────────────────────────────────────
# Live availability + booking so the agent can put real appointments on a calendar.
# https://cal.com/docs/api-reference
CALCOM_API_KEY=

# ── CRM (optional: forward to an external CRM too) ───────────────────────────
# The "CRM'e kaydet" action always writes to our own `crm_records` table in
# Supabase (see below + supabase/schema.sql) — that's the internal CRM at /crm.
# Set this too if you ALSO want each call forwarded to an external CRM via
# Zapier/Make/n8n's "Catch Hook" step or a CRM's own incoming webhook.
# https://zapier.com/apps/webhook/integrations
CRM_WEBHOOK_URL=

# ── CRM senkron cron'u (opsiyonel) ───────────────────────────────────────────
# /api/cron/crm-sync her 5 dakikada bir (vercel.json) `calls` tablosundaki
# çağrıları `crm_records`'a upsert eder — webhook'un kaçırdığı kayıtlar için
# güvenlik ağı. Bu değer set edilirse endpoint `Authorization: Bearer <secret>`
# ister; Vercel Cron bu header'ı otomatik gönderir. Boş bırakılırsa endpoint
# korumasızdır (sadece local geliştirme için).
CRON_SECRET=

# ── Waitlist welcome email (n8n) ──────────────────────────────────────────────
# When someone joins the /on-kayit waitlist, their email is POSTed to this n8n
# Webhook node's Production URL, which sends them an AI-personalized welcome
# email. Leave empty to skip — the signup still works without it.
WAITLIST_WEBHOOK_URL=

# ── Supabase (accounts, agents, call history) ────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
